# ---------------------------------------------------------------------------
# Zybble — environment variables
#
# Copy to `.env.local` for development. Every integration reports whether it is
# configured (GET /api/health lists the flags), and the UI gates features on
# that rather than assuming. No secret is read at build time.
#
# NEVER commit a filled-in copy. Never expose anything but the NEXT_PUBLIC_*
# values to the browser — the service-role key and provider secrets are
# server-only and are compiled out of the client bundle.
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
# Absolute origin used for emails, OAuth redirects and webhook URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Google Search Console verification token — renders a
# google-site-verification meta tag when set (production only in practice).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Public support address shown on /contact and the legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=tejassutar.business@gmail.com
# Optional explicit origin for transactional email links (defaults to the above).
# APP_URL=https://app.zybble.com

# --- Supabase (auth, Postgres) -----------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase now calls this the *publishable* key; the legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# SERVER ONLY. Bypasses RLS — used by webhooks and background jobs only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Project Settings → Database → Connection string.
# Use the pooled connection (port 6543) in production; required for the
# transactional paths (webhook claim, publish claim).
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Cloudflare R2 (media storage) -------------------------------------------
# All media — images, video, documents — lives in R2, reached over its
# S3-compatible API. Supabase Storage is no longer used at all.
#
# Dashboard → R2 → Overview: the Account ID is in the right-hand sidebar.
# Dashboard → R2 → Manage R2 API Tokens: create a token with
# "Object Read & Write" scoped to the bucket below.
R2_ACCOUNT_ID=your-33-character-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
# Bucket name. Create it in the dashboard; it is NOT created automatically.
# Keep it PRIVATE unless you also set R2_PUBLIC_URL below.
R2_BUCKET=zybble-post-media
#
# Optional. Set this only if you deliberately enable public read on the bucket
# (via a custom domain or the r2.dev subdomain). Previews then use plain,
# cacheable links instead of 60-second signed URLs. Leave it unset to keep the
# bucket private — the default, and the behaviour R2 was migrated with.
# R2_PUBLIC_URL=https://media.zybble.com
#
# IMPORTANT — CORS: because uploads go straight from the browser to R2, the
# bucket needs a CORS policy allowing PUT from your origin. See DEPLOYMENT.md
# step C.6. Without it, uploads fail in the browser with an opaque CORS error.

# --- LinkedIn ---------------------------------------------------------------
# LinkedIn Developer Portal → your app → Auth.
# Redirect URI must be registered EXACTLY as:
#   http://localhost:3000/api/linkedin/callback            (development)
#   https://your-domain.com/api/linkedin/callback          (production)
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# Pinned LinkedIn API version (YYYYMM).
LINKEDIN_API_VERSION=202604
# Request r_member_postAnalytics? Only after LinkedIn approves the
# Community Management API product. Requesting an unapproved scope aborts the
# entire consent screen, so it stays OFF until approval.
LINKEDIN_ANALYTICS_SCOPE_ENABLED=false

# --- Inngest (durable jobs) -------------------------------------------------
# Two separate credentials, two separate jobs:
#
#   INNGEST_EVENT_KEY   authorises events this app SENDS to Inngest.
#   INNGEST_SIGNING_KEY authorises requests Inngest SENDS to /api/inngest.
#
# The signing key is the one that matters for reachability. In production the
# SDK runs in cloud mode, where it verifies a signature on every request; with
# no signing key it refuses GET, PUT and POST alike, /api/inngest returns 503,
# and the Inngest dashboard reports the URL as unreachable.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Force the dev server (http://localhost:8288) even with NODE_ENV=production.
# A dev server needs no signing key. Never set this in production.
# INNGEST_DEV=true

# --- Dodo Payments ----------------------------------------------------------
DODO_PAYMENTS_API_KEY=
# Dashboard → Webhooks → Secret (starts with `whsec_`).
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Pro product id; quantity = billable seats at $15/seat/month.
DODO_PRO_PRODUCT_ID=pdt_...
# Optional per-seat add-on id (only if you model seats as an add-on).
# DODO_PRO_SEAT_ADDON_ID=
# How seat changes are billed: prorated_immediately | full_immediately |
# difference_immediately | do_not_bill | prorated_immediately_keep_cycle
DODO_SEAT_PRORATION_MODE=difference_immediately

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=
# Must use a verified sending domain.
# Delivery inbox for the /contact form (server-only; defaults to the support address).
CONTACT_FORM_TO=tejassutar.business@gmail.com

EMAIL_FROM=Zybble <no-reply@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com

# --- Security ---------------------------------------------------------------
# 32 random bytes, base64. Encrypts LinkedIn tokens at the application layer.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Previous key, kept during a rotation.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Shared secret for GET /api/cron/run (Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=
